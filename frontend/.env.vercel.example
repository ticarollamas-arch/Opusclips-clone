# Cortador 9:16 — variáveis do site na Vercel (Settings > Environment Variables).
# Root Directory do projeto na Vercel: frontend

NEXT_PUBLIC_APP_URL=https://cortador916.com
BETTER_AUTH_URL=https://cortador916.com
BETTER_AUTH_SECRET=                 # openssl rand -hex 32
NEXT_PUBLIC_SELF_HOST=false         # liga planos e cobrança

# Banco na VPS (TLS com certificado próprio)
DATABASE_URL=postgresql://supoclip:SENHA@IP-DA-VPS:5432/supoclip?sslmode=require&sslaccept=accept_invalid_certs

# Backend na VPS publicado pelo Cloudflare Tunnel
NEXT_PUBLIC_API_URL=https://api.cortador916.com
BACKEND_INTERNAL_URL=https://api.cortador916.com
BACKEND_AUTH_SECRET=                # mesmo valor da VPS
APP_SETTINGS_ENCRYPTION_KEY=        # mesmo valor da VPS

# Planos (R$)
NEXT_PUBLIC_PRO_PRICE_MONTHLY=7
NEXT_PUBLIC_PRO_PRICE_ANNUAL=47
NEXT_PUBLIC_PRO_PLAN_MINUTE_LIMIT=120   # igual a PRO_PLAN_MINUTE_LIMIT da VPS
NEXT_PUBLIC_PRO_YOUTUBE_MAX_MINUTES=60
NEXT_PUBLIC_SOCIAL_PUBLISHING=off

# Kiwify ou Hotmart
CHECKOUT_URL_MENSAL=https://pay.kiwify.com.br/SEU-LINK-MENSAL
CHECKOUT_URL_ANUAL=https://pay.kiwify.com.br/SEU-LINK-ANUAL
CHECKOUT_ANNUAL_IDS=                # IDs do produto/oferta anual (opcional, separados por vírgula)
CHECKOUT_WEBHOOK_SECRET=            # openssl rand -hex 24; vai na URL do webhook
CHECKOUT_CUSTOMER_PORTAL_URL=https://dashboard.kiwify.com.br/
KIWIFY_WEBHOOK_TOKEN=               # opcional: token do webhook da Kiwify
HOTMART_HOTTOK=                     # opcional: hottok da Hotmart

# Quem opera o serviço (aparece no rodapé e nos termos)
NEXT_PUBLIC_COMPANY_NAME=CyberHuntLab
NEXT_PUBLIC_SOURCE_CODE_URL=https://github.com/ticarollamas-arch/Opusclips-clone
