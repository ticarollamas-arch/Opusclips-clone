# Cortador 9:16 — variáveis da VPS (backend, workers, PostgreSQL, Ollama).
# Copie para .env na raiz do projeto, na VPS, e preencha.
# Nenhuma chave de API de IA de terceiros é necessária.

# Endereço público do site (o mesmo configurado na Vercel)
NEXT_PUBLIC_APP_URL=https://cortador916.com

# Banco de dados: troque por uma senha longa e aleatória (ex.: openssl rand -hex 32)
POSTGRES_PASSWORD=
POSTGRES_PUBLIC_PORT=5432

# Segredos compartilhados com a Vercel (mesmos valores nos dois lados)
# Gere cada um com: openssl rand -hex 32
BACKEND_AUTH_SECRET=
APP_SETTINGS_ENCRYPTION_KEY=
REDIS_PASSWORD=

# Imagem do backend só com CPU (sem CUDA)
BACKEND_CPU_ONLY=true
BACKEND_PLATFORM=linux/amd64

# IA local
WHISPER_MODEL_SIZE=small          # tiny | base | small | medium (maior = melhor e mais lento)
TRANSCRIPTION_LANGUAGE=pt
LLM=ollama:qwen2.5:7b-instruct
AI_EDIT_MODEL=ollama:qwen2.5:7b-instruct

# Limites por assinante (protegem a VPS)
PRO_PLAN_MINUTE_LIMIT=120         # minutos de vídeo por mês
MAX_VIDEO_DURATION=3600           # vídeo de até 60 min
MAX_CLIPS=6

# Cloudflare Tunnel: api.cortador916.com -> http://backend:8000
CLOUDFLARE_TUNNEL_TOKEN=

# E-mail (recuperação de senha) pela sua própria caixa de e-mail
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Cortador 9:16 <contato@cortador916.com>

# Opcional: cookies do YouTube (arquivo Netscape) se o link do YouTube der "Sign in to confirm you're not a bot".
# Use uma conta descartável. Coloque o arquivo em deploy/vps/cookies/youtube.txt e descomente:
# YOUTUBE_COOKIES_FILE=/app/cookies/youtube.txt
